# Frontend: Firebase Web app client configuration. These values are not Admin credentials.
VITE_API_BASE_URL=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Backend: optional services. Prefer ADC locally and a managed identity in production.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_USE_APPLICATION_DEFAULT_CREDENTIALS=false
GOOGLE_APPLICATION_CREDENTIALS=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=
POSTGRES_PASSWORD=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ENABLE_EMBEDDINGS=false
